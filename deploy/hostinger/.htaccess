# flowline.it su Hostinger: copiato nella cartella pubblicata solo dalla build di produzione.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. www.flowline.it → https://flowline.it. Il passaggio da http a https lo fa Hostinger
  #    (hPanel → Sicurezza → SSL → Forza HTTPS): con la CDN attiva una regola qui potrebbe creare un loop.
  RewriteCond %{HTTP_HOST} ^www\.flowline\.it$ [NC]
  RewriteRule ^ https://flowline.it%{REQUEST_URI} [R=301,L]

  # Qualsiasi altro indirizzo (per esempio il dominio temporaneo di Hostinger) resta visibile come anteprima,
  # ma fuori dai motori di ricerca (vedi X-Robots-Tag più sotto).
  RewriteCond %{HTTP_HOST} !^(www\.)?flowline\.it$ [NC]
  RewriteRule ^ - [E=ANTEPRIMA:1]

  # 2. Vecchie pagine del sito precedente → pagine nuove (una riga per indirizzo, da completare)
  # RewriteRule ^vecchia-pagina/?$ https://flowline.it/nuova-pagina/ [R=301,L]

  # Le pagine sono cartelle: /metodo diventa /metodo/ da solo (comportamento standard del server),
  # ed è la forma usata da canonical, sitemap e link del sito.
</IfModule>

# CSS, JS e font hanno il nome versionato (cartella _astro): in cache per un anno; HTML sempre aggiornato
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # anteprima su domini diversi da flowline.it: mai in Google
  Header always set X-Robots-Tag "noindex, nofollow" env=ANTEPRIMA
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_ANTEPRIMA
</IfModule>
