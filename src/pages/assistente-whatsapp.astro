---
// Pagina del prodotto in sviluppo: resta fuori dall'indice finché non è pronto; il contenuto vive in /prodotti.
import { p } from '../lib/paths.js';
import Base from '../layouts/Base.astro';
import { PRODUCTS, SITE } from '../data/site.js';
const pr = PRODUCTS.items.find((x) => x.id === 'assistente-whatsapp')!;
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base title={`${pr.name}: in arrivo | Flowline`} description={pr.text} path="/assistente-whatsapp" noindex>
  <section class="section wip">
    <div class="wrap">
      <span class="badge wip__badge" data-rise>{pr.status}</span>
      <h1 class="display" data-rise style="--i:1">{pr.name}</h1>
      <p class="lead" data-rise style="--i:2">{pr.text}</p>
      <p data-rise style="--i:3">{pr.note}</p>
      <p class="wip__ctas" data-rise style="--i:4">
        <a class="button button--ink" href={`mailto:${SITE.email}?subject=${encodeURIComponent(pr.name + ': voglio provarlo')}`}>Avvisami quando è pronto <Fragment set:html={arrow} /></a>
        <a class="button button--ghost" href={p('/prodotti')}>Tutti i prodotti</a>
      </p>
    </div>
    <span class="wip__line" aria-hidden="true"></span>
  </section>
</Base>

<style>
  .wip { position: relative; min-height: 70svh; padding-top: clamp(2rem, 7vw, 6rem); overflow: hidden; }
  .wip .wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .wip .lead { max-width: 36ch; font-weight: 500; }
  .wip__badge { background: var(--accent-soft); color: var(--accent-text); }
  .wip__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  /* la linea ancora in costruzione: si ferma prima di arrivare */
  .wip__line { position: absolute; left: 0; bottom: 14%; width: 58%; height: clamp(28px, 4vw, 56px); background: var(--accent); border-radius: 0 999px 999px 0; z-index: -1; }
</style>
