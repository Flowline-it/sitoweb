---
import Base from '../layouts/Base.astro';
import { p } from '../lib/paths.js';
import { CTA, PLANS, FAQ, FAQ_EXTRA, SITE } from '../data/site.js';

// Pagina del Pilot 30. Tutti i testi vengono da site.js (formula PLANS, FAQ, metodo):
// se cambia l'offerta, si aggiorna lì e la pagina segue.
const pilot = PLANS.items[0];
const custom = PLANS.items[1];
const care = PLANS.items[2];
const META = {
  title: 'Pilot 30: automazione AI in 30 giorni | Flowline',
  description:
    "Il modo più semplice per iniziare con l'automazione AI: in 30 giorni automatizziamo un processo concreto della tua azienda e misuriamo le ore risparmiate.",
};
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

// i 30 giorni ricalcano il metodo (settimana 1 analisi, 2 progettazione, 3-4 implementazione), su un solo processo
const phases = [
  { when: 'Settimana 1', name: 'Analisi del processo', text: 'Scegliamo insieme il processo da automatizzare e lo mappiamo per trovare colli di bottiglia e passaggi manuali.' },
  { when: 'Settimana 2', name: 'Progettazione', text: "Disegniamo l'automazione, scegliendo strumenti e integrazioni adatti a quelli che la tua azienda usa già." },
  { when: 'Settimane 3-4', name: 'Implementazione e test', text: "Sviluppiamo, integriamo e testiamo l'automazione in ambiente sicuro, poi la mettiamo al lavoro." },
  { when: 'Giorno 30', name: 'Report dei risultati', text: 'Ti consegniamo il report con le ore risparmiate, così decidi su numeri concreti se e come andare oltre.' },
];
const faqs = [FAQ_EXTRA, FAQ.items[1], FAQ.items[2]];
const url = `${SITE.url}/pilot-30`;
const jsonld = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: META.title, description: META.description, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${url}#service` }, breadcrumb: { '@id': `${url}#breadcrumb` } },
  { '@type': 'Service', '@id': `${url}#service`, name: 'Pilot 30', serviceType: 'Automazione dei processi aziendali con intelligenza artificiale', description: `${pilot.text} ${FAQ_EXTRA.a}`, provider: { '@id': `${SITE.url}/#organization` }, areaServed: { '@type': 'Country', name: 'Italia' } },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Pilot 30', item: url },
  ] },
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={META.title} description={META.description} path="/pilot-30" jsonld={jsonld}>
  <section class="page-hero" aria-labelledby="page-title">
    <span class="glow page-hero__glow" aria-hidden="true"></span>
    <div class="wrap page-hero__inner">
      <nav class="crumbs" aria-label="Percorso" data-rise style="--i:0">
        <a href={p('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Pilot 30</span>
      </nav>
      <h1 id="page-title" class="display" data-rise style="--i:1">Pilot 30: il tuo primo processo automatizzato con l'AI in 30 giorni</h1>
      <p class="lead" data-rise style="--i:2">{pilot.text}</p>
      <div class="page-hero__ctas" data-rise style="--i:3">
        <a class="button" href={p('/#contatti')}>{pilot.cta} <Fragment set:html={arrow} /></a>
        <a class="button button--ghost" href={p('/metodo')}>Scopri il nostro metodo</a>
      </div>
      <ul class="facts" role="list" data-rise style="--i:4">
        <li><b>30 giorni</b><small>dall'analisi al report</small></li>
        <li><b>1 processo</b><small>concreto, scelto insieme</small></li>
        <li><b>{pilot.price}</b><small>dopo l'analisi gratuita</small></li>
      </ul>
    </div>
  </section>

  <!-- cos'è + cosa ottieni -->
  <section class="section" aria-labelledby="what-title">
    <div class="wrap split">
      <div class="split__text">
        <span class="eyebrow" data-reveal><span class="dot"></span>Cos'è</span>
        <h2 id="what-title" class="h2" data-reveal style="--i:1">Vedi i risultati prima di andare oltre</h2>
        <p class="lead" data-reveal style="--i:2">{FAQ_EXTRA.a}</p>
      </div>
      <div class="card split__box" data-reveal style="--i:2">
        <h3>Cosa è incluso</h3>
        <ul class="checks">{pilot.points.map((pt) => <li>{pt}</li>)}</ul>
        <a class="button" href={p('/#contatti')}>{CTA} <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- come funzionano i 30 giorni -->
  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow" data-reveal><span class="dot"></span>Come funziona</span>
        <h2 id="how-title" class="h2" data-reveal style="--i:1">Trenta giorni, quattro tappe</h2>
      </header>
      <ol class="phases" role="list">
        {phases.map((s, i) => (
          <li class="card" data-reveal style={`--i:${i}`}>
            <span class="phases__num" aria-hidden="true">{i + 1}</span>
            <p class="phases__when">{s.when}</p>
            <h3>{s.name}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- e dopo -->
  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow" data-reveal><span class="dot"></span>Dopo il Pilot</span>
        <h2 id="next-title" class="h2" data-reveal style="--i:1">E dopo i 30 giorni?</h2>
        <p class="lead" data-reveal style="--i:2">Se il risultato ti convince, puoi estendere l'automazione ad altri processi o affidarci la manutenzione di quello che abbiamo costruito.</p>
      </header>
      <div class="next">
        {[custom, care].map((pl, i) => (
          <article class="card card--hover" data-reveal style={`--i:${i}`}>
            <h3>{pl.name}</h3>
            <p class="next__note">{pl.note}</p>
            <p class="muted">{pl.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- domande -->
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap qa">
      <h2 id="faq-title" class="h2" data-reveal>Domande sul Pilot 30</h2>
      <div class="qa__list">
        {faqs.map((f, i) => (
          <div class="qa__item" data-reveal style={`--i:${i}`}>
            <h3>{f.q}</h3>
            <p class="muted">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="end-title">
    <div class="wrap">
      <div class="end" data-reveal>
        <h2 id="end-title" class="h2">Quale processo automatizziamo per primo?</h2>
        <p class="lead">Raccontaci come lavorate oggi: l'analisi preliminare è gratuita e senza impegno.</p>
        <a class="button button--ink" href={p('/#contatti')}>{pilot.cta} <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero { position: relative; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem); overflow: hidden; }
  .page-hero__glow { width: min(64rem, 140vw); height: 34rem; left: 50%; top: -14rem; transform: translateX(-50%); }
  .page-hero__inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .page-hero h1 { max-width: 18ch; }
  .page-hero .lead { max-width: 38rem; }
  .page-hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .crumbs { display: flex; gap: 0.5rem; font-size: 0.875rem; color: var(--muted); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs [aria-current] { color: var(--ink); font-weight: 500; }
  @media (hover: hover) and (pointer: fine) { .crumbs a:hover { color: var(--ink); } }
  @media (max-width: 640px) { .page-hero__ctas .button { width: 100%; } }

  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: min(100%, 40rem); margin-top: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .facts li { padding: 1.1rem 0.75rem; display: grid; gap: 0.15rem; }
  .facts li + li { border-left: 1px solid var(--border); }
  .facts b { font-family: var(--font-head); font-weight: 600; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem); letter-spacing: -0.02em; }
  .facts small { font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; } .facts li + li { border-left: 0; border-top: 1px solid var(--border); } }

  .split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .split__text { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .split__box { display: flex; flex-direction: column; gap: 1.1rem; }
  .split__box .button { align-self: flex-start; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }

  .phases { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .phases .card { display: flex; flex-direction: column; gap: 0.45rem; }
  .phases .muted { font-size: 0.95rem; }
  .phases__num { width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-text); font-family: var(--font-head); font-weight: 600; margin-bottom: 0.5rem; }
  .phases li:last-child .phases__num { background: var(--accent); color: var(--accent-ink); }
  .phases__when { font-size: 0.8rem; font-weight: 600; color: var(--accent-text); }
  @media (max-width: 1024px) { .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .phases { grid-template-columns: 1fr; } }

  .next { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 54rem; margin-inline: auto; }
  .next .card { display: flex; flex-direction: column; gap: 0.5rem; }
  .next__note { font-size: 0.85rem; font-weight: 500; color: var(--accent-text); }
  @media (max-width: 700px) { .next { grid-template-columns: 1fr; } }

  .qa { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .qa__list { display: grid; gap: 1.75rem; }
  .qa__item { display: grid; gap: 0.5rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--border); }
  .qa__item:last-child { border-bottom: 0; padding-bottom: 0; }
  .qa__item p { max-width: 60ch; }
  @media (max-width: 860px) { .qa { grid-template-columns: 1fr; } }

  .end { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.1rem; padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 3rem); border-radius: 32px; background: radial-gradient(120% 140% at 15% 0%, #ffc56b 0%, #ff9900 45%, #f07f00 100%); }
  .end .lead { max-width: 34rem; color: #2a1a00; }
</style>
