---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import LineDiagram from '../components/LineDiagram.astro';
import ContactForm from '../components/ContactForm.astro';
import { HOME_META, CTA, HERO, COSTS, SOLUTIONS, WHY, ABOUT, METHOD, SERVICES, FAQ, FINAL, SITE } from '../data/site.js';

import ducati from '../assets/img/ducati-1957.jpg';
import lingotto39 from '../assets/img/lingotto-1939.jpg';
import lingotto63 from '../assets/img/lingotto-1963.jpg';
import outbound from '../assets/img/outbound-partenze.png';
import p101 from '../assets/img/programma-101.jpg';
import ivrea from '../assets/img/ivrea-olivetti.jpg';
import perforatrici from '../assets/img/perforatrici.jpg';

const serviceImages: Record<string, { src: any; alt: string; caption: string }> = {
  automazioni: { src: outbound, alt: 'Il tabellone "Partenze di oggi" di FlowLine Outbound, con le email in partenza e quelle in ritardo', caption: 'FlowLine Outbound, il nostro strumento interno per le email commerciali. Dati dimostrativi.' },
  agenti: { src: p101, alt: 'La calcolatrice programmabile Olivetti Programma 101 in una teca museale', caption: 'Olivetti Programma 101, Ivrea, 1965. Foto d’archivio.' },
  consulenza: { src: ivrea, alt: 'La facciata in mattoni rossi del primo stabilimento Olivetti a Ivrea', caption: 'Ivrea, primo stabilimento Olivetti. Foto d’archivio.' },
  formazione: { src: perforatrici, alt: 'Due operatrici al lavoro su perforatrici di schede in un ufficio degli anni Settanta', caption: 'Operatrici di perforatrici di schede. Foto d’archivio.' },
};

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

const jsonld = [
  { '@type': 'WebPage', '@id': `${SITE.url}/#webpage`, url: `${SITE.url}/`, name: HOME_META.title, description: HOME_META.description, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` } },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: FAQ.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ...SERVICES.items.map((s) => ({ '@type': 'Service', name: s.name, description: `${s.text} ${s.quote}`, provider: { '@id': `${SITE.url}/#organization` }, areaServed: 'IT' })),
];
---
<Base title={HOME_META.title} description={HOME_META.description} path="/" jsonld={jsonld}>
  <!-- HERO: il marchio a scala di manifesto; la linea sottolinea il contenuto ed entra nel cerchio -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__inner">
      <h1 id="hero-title" class="display hero__title">
        <span data-rise style="--i:0">{HERO.title[0]}</span>
        <span data-rise style="--i:1">{HERO.title[1]}</span>
      </h1>
      <p class="lead" data-rise style="--i:2">{HERO.lead}</p>
      <p class="hero__text" data-rise style="--i:3">{HERO.text}</p>
      <p data-rise style="--i:4"><a class="button" href="#contatti">{CTA} <Fragment set:html={arrow} /></a></p>
    </div>
    <div class="hero__line" aria-hidden="true">
      <svg class="hero__mark" viewBox="60 80 1800 1800" aria-hidden="true" focusable="false">
        <defs>
        <mask id="hero-gap"><rect x="-40000" y="-2000" width="80000" height="6000" fill="#fff" /><rect x="0" y="730" width="520" height="568" fill="#000" /></mask>
        </defs>
        <path class="hero__ring" mask="url(#hero-gap)" fill-rule="evenodd" d="M958 83a877 877 0 1 0 0.1 0zM958 320a640 640 0 1 1-0.1 0z" />
        <rect class="hero__bar" x="-40000" y="898" width="40482" height="205" />
        <circle class="hero__disc" cx="968" cy="965" r="515" />
      </svg>
    </div>
  </section>

  <!-- IL COSTO DELL'INEFFICIENZA: un tabellone di perdite -->
  <section class="section dark costs" aria-labelledby="costs-title">
    <div class="wrap grid">
      <div class="costs__intro">
        <h2 id="costs-title" class="head" data-reveal>{COSTS.title}</h2>
        <p class="lead" data-reveal style="--i:1">{COSTS.statement}</p>
        <p class="muted" data-reveal style="--i:2">{COSTS.text}</p>
        <figure class="photo costs__photo shutter" data-reveal>
          <Picture src={ducati} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 38vw" alt="Operai alla linea di montaggio della Ducati 98 a Borgo Panigale" />
          <figcaption>Bologna, linea di montaggio della Ducati 98, 1957 circa. Foto d'archivio.</figcaption>
        </figure>
      </div>
      <ul class="board" role="list">
        {COSTS.rows.map((r, i) => (
          <li class="board__row" data-reveal style={`--i:${i}`}>
            <div>
              <h3 class="name">{r.name}</h3>
              <p class="muted">{r.text}</p>
            </div>
            <p class="board__value"><span class="figure">{r.value}</span><span class="board__unit">{r.unit}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOLUZIONI: la foto della linea, poi quattro cifre in fila -->
  <section class="section solutions" aria-labelledby="solutions-title">
    <div class="wrap">
      <h2 id="solutions-title" class="head solutions__title" data-reveal>{SOLUTIONS.title}</h2>
      <p class="lead solutions__sub" data-reveal style="--i:1">{SOLUTIONS.subtitle}</p>
    </div>
    <figure class="photo solutions__photo shutter" data-reveal>
      <Picture src={lingotto39} formats={['avif', 'webp']} widths={[640, 1000, 1500]} sizes="100vw" alt="Automobili Fiat 1100 sulla rampa della linea di montaggio del Lingotto" />
      <figcaption class="wrap">Torino, Lingotto, linea della Fiat 1100, 1939. Foto d'archivio.</figcaption>
    </figure>
    <div class="wrap">
      <ul class="figures grid" role="list">
        {SOLUTIONS.items.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <p class="figures__fig"><span class="figure">{s.figure}</span><span class="figures__label">{s.figureLabel}</span></p>
            <h3 class="name">{s.name}</h3>
            <p>{s.text}</p>
            <p class="small muted">{s.time} · Garantito</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PERCHÉ FLOWLINE -->
  <section class="section white why" aria-labelledby="why-title">
    <div class="wrap grid">
      <div class="why__side">
        <h2 id="why-title" class="head" data-reveal>{WHY.title}</h2>
        <p data-reveal style="--i:1">{WHY.text}</p>
      </div>
      <ul class="why__list dash" role="list">
        {WHY.items.map((w, i) => (
          <li data-reveal style={`--i:${i % 2}`}>
            <h3 class="name">{w.name}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="wrap">
      <div class="why__cta" data-reveal>
        <div>
          <h3 class="lead">{WHY.cta.title}</h3>
          <p>{WHY.cta.text}</p>
        </div>
        <a class="button" href="#contatti">{WHY.cta.button} <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- CHI SIAMO: pannello antracite, foto nel cerchio del marchio -->
  <section id="chi-siamo" class="section about" aria-labelledby="about-title">
    <div class="about__panel dark">
      <div class="about__text">
        <h2 id="about-title" class="head" data-reveal>{ABOUT.title}</h2>
        <p class="lead" data-reveal style="--i:1">{ABOUT.text}</p>
        <p class="about__closing name" data-reveal style="--i:2">{ABOUT.closing}</p>
      </div>
      <figure class="about__photo" data-reveal>
        <div class="about__disc">
          <Picture src={lingotto63} formats={['avif', 'webp']} widths={[480, 800, 1067]} sizes="(max-width: 860px) 86vw, 40vw" alt="Fiat 1100 D in uscita dalla linea di montaggio del Lingotto" />
        </div>
        <figcaption class="small">Torino, Lingotto, linea della Fiat 1100 D, 1963. Foto d'archivio.</figcaption>
      </figure>
    </div>
  </section>

  <!-- COME LAVORIAMO: il lavoro sparso diventa la linea -->
  <section id="come-lavoriamo" class="section method" aria-labelledby="method-title">
    <div class="wrap">
      <h2 id="method-title" class="head" data-reveal>{METHOD.title}</h2>
      <div class="method__diagram">
        <div class="only-wide"><LineDiagram /></div>
        <div class="only-narrow"><LineDiagram vertical /></div>
      </div>
      <ol class="method__steps grid" role="list">
        {METHOD.steps.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <p class="method__when">{s.when}</p>
            <h3 class="name">{s.name}</h3>
            <p>{s.text}</p>
            <p class="small muted">Output: {s.output}</p>
          </li>
        ))}
      </ol>
      <p class="method__note" data-reveal>{METHOD.note}</p>
    </div>
  </section>

  <!-- SERVIZI: elenco con anteprima -->
  <section id="servizi" class="section white services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="services__head grid">
        <h2 id="services-title" class="head" data-reveal>{SERVICES.title}</h2>
        <p class="lead" data-reveal style="--i:1">{SERVICES.text}</p>
      </div>
      <div class="index">
        <ul class="index__list" role="list">
          {SERVICES.items.map((s, i) => (
            <li class="index__row" data-key={s.id} data-reveal>
              <figure class="photo index__inline" data-key={s.id}>
                <Picture src={serviceImages[s.id].src} formats={['avif', 'webp']} widths={[480, 800]} sizes="92vw" alt={serviceImages[s.id].alt} loading="lazy" />
                <figcaption>{serviceImages[s.id].caption}</figcaption>
              </figure>
              <h3 class="index__name">{s.name}</h3>
              <p class="lead">{s.text}</p>
              <div class="index__more">
                <p class="muted">{s.quote}</p>
                <ul class="dash" role="list">{s.points.map((p) => <li>{p}</li>)}</ul>
              </div>
              <a class="link" href="#contatti">{SERVICES.link}</a>
            </li>
          ))}
        </ul>
        <div class="index__frame" aria-hidden="true">
          {SERVICES.items.map((s, i) => (
            <figure class:list={['photo', 'index__shot', i === 0 && 'is-on']} data-key={s.id}>
              <div class="index__img"><Picture src={serviceImages[s.id].src} formats={['avif', 'webp']} widths={[600, 1000]} sizes="38vw" alt="" loading="lazy" /></div>
              <figcaption>{serviceImages[s.id].caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="services__foot" data-reveal>
        <p class="lead">{SERVICES.note}</p>
        <p class="muted">{SERVICES.closing}</p>
      </div>
    </div>
  </section>

  <ContactForm />

  <!-- FAQ -->
  <section id="faq" class="section white faq" aria-labelledby="faq-title">
    <div class="wrap grid">
      <div class="faq__side">
        <h2 id="faq-title" class="head" data-reveal>{FAQ.title}</h2>
        <p data-reveal style="--i:1">{FAQ.aside}</p>
        <p data-reveal style="--i:2"><a class="button" href="#contatti">{CTA} <Fragment set:html={arrow} /></a></p>
      </div>
      <div class="faq__list">
        {FAQ.items.map((f, i) => (
          <details name="faq" class="faq__item" data-reveal style={`--i:${i}`} open={i === 0}>
            <summary><span>{f.q}</span><span class="faq__sign" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CHIAMATA FINALE: un campo pieno arancio -->
  <section class="final" aria-labelledby="final-title">
    <div class="wrap">
      <h2 id="final-title" class="display" data-reveal>{FINAL.title}</h2>
      <div class="final__row">
        <p class="lead" data-reveal style="--i:1">{FINAL.text}</p>
        <p data-reveal style="--i:2"><a class="button button--ink" href="#contatti">{CTA} <Fragment set:html={arrow} /></a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Servizi: l'anteprima segue la riga indicata (solo con mouse; su touch l'immagine sta nella riga)
  const rows = document.querySelectorAll<HTMLElement>('.index__row');
  const shots = document.querySelectorAll<HTMLElement>('.index__shot');
  const list = document.querySelector('.index__list');
  const activate = (key: string) => {
    shots.forEach((s) => s.classList.toggle('is-on', s.dataset.key === key));
    rows.forEach((r) => r.classList.toggle('is-active', r.dataset.key === key));
  };
  rows.forEach((r) => {
    r.addEventListener('pointerenter', () => activate(r.dataset.key!));
    r.addEventListener('focusin', () => activate(r.dataset.key!));
  });
  if (rows[0]) activate(rows[0].dataset.key!);
  // senza mouse, la riga attiva è quella al centro dello schermo
  if (list && !matchMedia('(hover: hover)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && activate((e.target as HTMLElement).dataset.key!)), { rootMargin: '-45% 0px -45% 0px' });
    rows.forEach((r) => io.observe(r));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero { --w: min(86svh, 56vw, 54rem); position: relative; overflow: hidden; padding-top: clamp(2rem, 7vh, 5rem); padding-bottom: calc(var(--w) * 0.2); }
  .hero__inner { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.25rem; }
  .hero__title span { display: block; }
  .hero__title { margin-bottom: 0.25rem; }
  .hero__inner .lead { max-width: 30ch; font-weight: 600; }
  .hero__text { max-width: 30rem; }
  .hero__inner .button { margin-top: 0.25rem; }
  /* la riga della linea: alta quanto la barra del marchio; anello e cerchio sporgono sopra e sotto */
  .hero__line { position: relative; height: calc(var(--w) * 0.1139); margin-top: clamp(2.5rem, 7vh, 4.5rem); }
  .hero__mark { position: absolute; width: var(--w); height: var(--w); left: calc(79% - var(--w) * 0.5044); top: calc(var(--w) * -0.4544); overflow: visible; }
  .hero__ring { fill: var(--anthracite); }
  .hero__bar, .hero__disc { fill: var(--orange); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero__bar { transform: scaleX(0); transform-box: fill-box; transform-origin: right center; animation: bar-in 1300ms var(--ease-in-out) 350ms forwards; }
    :global(.js) .hero__disc { transform-box: fill-box; transform-origin: center; animation: disc-in 900ms var(--ease-out) 150ms both; }
  }
  @keyframes bar-in { to { transform: none; } }
  @keyframes disc-in { from { transform: scale(0.82); } to { transform: none; } }
  @media (max-width: 860px) {
    .hero { --w: 96vw; padding-top: 1.25rem; }
    .hero__title { font-size: clamp(2.5rem, 11.4vw, 4.5rem); }
    .hero__line { margin-top: calc(var(--w) * 0.47); }
    .hero__mark { left: calc(74% - var(--w) * 0.5044); }
  }

  /* ---------- costi ---------- */
  .costs .grid { row-gap: 3rem; }
  .costs__intro { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 1.25rem; }
  .costs__intro .head { max-width: 9ch; }
  .costs__photo { margin-top: 1.5rem; }
  .costs__photo img { aspect-ratio: 4 / 3; }
  .board { grid-column: 7 / -1; display: grid; gap: 4px; align-self: start; }
  .board__row { background: var(--anthracite-2); padding: clamp(1.25rem, 2.4vw, 2rem); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 16rem); gap: 1rem 2rem; align-items: end; }
  .board__row .name { margin-bottom: 0.4rem; }
  .board__value { display: flex; flex-direction: column; align-items: flex-end; text-align: right; gap: 0.3rem; }
  .board__value .figure { color: var(--board-ink); }
  .board__unit { font-size: var(--s-small); color: var(--board-ink); }
  @media (max-width: 960px) {
    .costs__intro, .board { grid-column: 1 / -1; }
    .board__row { grid-template-columns: 1fr; }
    .board__value { align-items: flex-start; text-align: left; }
  }

  /* ---------- soluzioni ---------- */
  .solutions__sub { margin-top: 0.75rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); font-weight: 600; }
  .solutions__photo img { aspect-ratio: 21 / 8; object-position: center 55%; }
  .solutions__photo figcaption { margin-top: 0.75rem; }
  .figures { margin-top: clamp(3rem, 6vw, 5rem); row-gap: 3rem; }
  .figures li { grid-column: span 3; display: flex; flex-direction: column; gap: 0.75rem; }
  .figures__fig { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.75rem; }
  .figures__label { font-size: var(--s-small); font-weight: 600; }
  @media (max-width: 960px) { .figures { row-gap: 5rem; } .figures li { grid-column: span 6; } .solutions__photo img { aspect-ratio: 16 / 10; } }
  @media (max-width: 560px) { .figures li { grid-column: 1 / -1; } }

  /* ---------- perché ---------- */
  .why__side { grid-column: 1 / span 5; position: sticky; top: 2rem; align-self: start; display: flex; flex-direction: column; gap: 1.5rem; }
  .why__list { grid-column: 7 / -1; display: grid; gap: clamp(2.25rem, 4vw, 3.5rem); }
  .why__list li { display: flex; flex-direction: column; gap: 0.6rem; }
  .why__list li::before { top: 0.6em; }
  .why__cta { margin-top: clamp(4rem, 8vw, 7rem); padding-top: clamp(1.75rem, 3vw, 2.5rem); border-top: 6px solid var(--orange); display: flex; justify-content: space-between; align-items: center; gap: 1.5rem 3rem; flex-wrap: wrap; }
  .why__cta h3 { font-weight: 700; margin-bottom: 0.35rem; }
  @media (max-width: 960px) {
    .why__side { position: static; grid-column: 1 / -1; margin-bottom: 3rem; }
    .why__list { grid-column: 1 / -1; }
  }

  /* ---------- chi siamo ---------- */
  .about { padding-inline: clamp(0.625rem, 1.4vw, 1.25rem); }
  .about__panel { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gutter); padding: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 4rem) 0; min-height: min(56rem, 100svh); }
  .about__text { display: flex; flex-direction: column; gap: 1.75rem; padding-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .about__text .lead { font-weight: 400; max-width: 34ch; }
  .about__closing { color: var(--board-ink); border-left: 0; }
  .about__photo { align-self: end; justify-self: end; width: min(100%, 40rem); margin: 0; display: flex; flex-direction: column-reverse; gap: 1rem; }
  .about__photo figcaption { color: var(--rail-ink); text-align: right; }
  .about__disc { aspect-ratio: 1; border-radius: 50%; overflow: hidden; margin-bottom: -22%; border: clamp(14px, 1.8vw, 26px) solid var(--anthracite-3); }
  .about__disc :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  @media (max-width: 860px) {
    .about__panel { grid-template-columns: 1fr; min-height: 0; }
    .about__text { padding-bottom: 0; }
    .about__photo { justify-self: center; width: 86%; }
  }

  /* ---------- metodo ---------- */
  .method__diagram { margin-block: clamp(2.5rem, 5vw, 4rem); }
  .only-narrow { display: none; }
  @media (max-width: 720px) { .only-wide { display: none; } .only-narrow { display: block; max-width: 22rem; margin-inline: auto; } }
  .method__steps { row-gap: 2.5rem; }
  .method__steps li { grid-column: span 3; display: flex; flex-direction: column; gap: 0.7rem; }
  .method__when { font-weight: 700; color: var(--burnt); font-size: var(--s-small); }
  .method__note { margin-top: clamp(3rem, 5vw, 4rem); font-weight: 600; }
  @media (max-width: 960px) { .method__steps li { grid-column: span 6; } }
  @media (max-width: 560px) { .method__steps li { grid-column: 1 / -1; } }

  /* ---------- servizi ---------- */
  .services__head { row-gap: 1.5rem; align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .services__head .head { grid-column: 1 / span 6; }
  .services__head .lead { grid-column: 7 / -1; font-weight: 400; }
  .index { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); }
  .index__list { display: grid; gap: 0; }
  .index__row { padding-block: clamp(2rem, 3.5vw, 3rem); display: flex; flex-direction: column; gap: 1rem; transition: opacity var(--t-hover) ease; }
  .index__row + .index__row { padding-top: clamp(2rem, 3.5vw, 3rem); }
  .index__name { font-size: var(--s-head); line-height: 0.95; }
  .index__row .lead { font-weight: 400; max-width: 30ch; }
  .index__more { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 1.5rem; margin-top: 0.25rem; }
  .index__more ul { display: grid; gap: 0.35rem; }
  .index__inline { display: none; }
  .index__frame { position: sticky; top: 2rem; align-self: start; display: grid; }
  .index__shot { grid-area: 1 / 1; opacity: 0; transition: opacity var(--t-ui) ease; margin: 0; }
  .index__shot.is-on { opacity: 1; }
  .index__img { aspect-ratio: 4 / 3; background: var(--anthracite); overflow: hidden; }
  .index__img :global(img) { width: 100%; height: 100%; object-fit: cover; background: transparent; }
  .index__shot[data-key='automazioni'] .index__img :global(img) { object-fit: contain; }
  @media (hover: hover) and (pointer: fine) {
    .index__list:hover .index__row:not(:hover) { opacity: 0.45; }
  }
  .services__foot { margin-top: clamp(3rem, 6vw, 5rem); display: flex; flex-direction: column; gap: 0.75rem; }
  .services__foot .lead { font-weight: 700; }
  @media (max-width: 860px) {
    .services__head .head, .services__head .lead { grid-column: 1 / -1; }
    .services__head .lead { font-size: var(--s-body); }
    .index { grid-template-columns: 1fr; }
    .index__frame { display: none; }
    .index__inline { display: block; margin-bottom: 0.75rem; }
    .index__inline :global(picture) { display: block; }
    .index__inline :global(img) { aspect-ratio: 16 / 10; height: auto; }
