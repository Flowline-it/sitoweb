---
import { p } from '../../lib/paths.js';
import Base from '../../layouts/Base.astro';
import { getArticles, fmtShort, excerpt } from '../../lib/journal.js';
import { CTA } from '../../data/site.js';
import JournalBar from '../../components/journal/JournalBar.astro';
import Card from '../../components/journal/Card.astro';
import Carousel from '../../components/journal/Carousel.astro';
import Orb from '../../components/journal/Orb.astro';
import Newsletter from '../../components/journal/Newsletter.astro';
import { I } from '../../components/journal/icons.js';
import '../../styles/journal.css';

const articles = await getArticles();
const empty = articles.length === 0;

// Distribuzione degli articoli. Le sezioni che hanno bisogno di molti articoli restano nascoste finché non ce ne sono abbastanza.
const featured = articles.find((a) => a.featured) || articles[0];
const others = articles.filter((a) => a !== featured);
const recommended = others.slice(0, 4);
const teasers = others.slice(4, 7);
const showAll = articles.length >= 8;
---
<Base
  title="Flowline Journal | Automazione e AI per le aziende"
  description="Flowline Journal: articoli su automazione, intelligenza artificiale, normative e casi reali per le PMI italiane."
  path="/journal"
  noindex={empty}
>
  <div class="jr">
    <JournalBar articles={articles} h1 />

    {empty ? (
      <section class="wrap">
        <div class="jhero__panel" style="display:block">
          <p class="jlabel">In preparazione</p>
          <h2 class="jhero__title" style="margin-top:1rem">I primi articoli arrivano a breve</h2>
          <p class="jhero__sub" style="margin-top:1rem">Nel frattempo, se vuoi capire cosa possiamo automatizzare nella tua azienda, parliamone direttamente.</p>
          <p style="margin-top:1.5rem"><a class="button" href={p('/#contatti')}>{CTA}</a></p>
        </div>
      </section>
    ) : (
      <>
        <!-- in evidenza + consigliati -->
        <section class="wrap jhero" aria-labelledby="feat-title">
          <div class="jhero__panel">
            <div class="jhero__main jstretch">
              <p class="jlabel" data-rise>In evidenza</p>
              <p class="jmeta" data-rise style="--i:1"><span class="jcat">{featured.category?.name}</span><time datetime={featured.published_at}>{fmtShort(featured.published_at)}</time><span>{featured.reading_time || 1} min di lettura</span></p>
              <h2 class="jhero__title" id="feat-title" data-split><a class="jlink" href={p(`/journal/${featured.slug}`)}>{featured.title}</a></h2>
              <p class="jhero__sub" data-rise style="--i:4">{excerpt(featured, 170)}</p>
              {featured.tags?.length > 0 && <p class="jtags" data-rise style="--i:5">{featured.tags.slice(0, 3).map((t) => <span>{t.name}</span>)}</p>}
              <span class="jbtn" data-rise style="--i:6" aria-hidden="true">Leggi l'articolo <i><Fragment set:html={I.arrow} /></i></span>
            </div>
            <div class="jhero__orb"><Orb follow /></div>
            {teasers.length === 3 && (
              <ul class="jhero__teasers" role="list">
                {teasers.map((a) => (
                  <li class="jstretch">
                    <p class="jmeta"><span class="jcat">{a.category?.name}</span><time datetime={a.published_at}>{fmtShort(a.published_at)}</time></p>
                    <h3><a class="jlink" href={p(`/journal/${a.slug}`)}>{a.title}</a></h3>
                  </li>
                ))}
              </ul>
            )}
            {recommended.length > 0 && (
              <aside class="jhero__side" aria-labelledby="rec-title" data-reveal style="--i:2">
                <div class="jhead"><h2 class="jlabel" id="rec-title">Consigliati</h2></div>
                <Card a={recommended[0]} eager tags={0} />
                {recommended.slice(1).map((a) => <Card a={a} variant="row" />)}
              </aside>
            )}
          </div>
        </section>

        <!-- ultimi articoli -->
        <section class="wrap jsec" aria-labelledby="latest-title">
          <div class="jhead"><h2 class="jlabel" id="latest-title">Ultimi articoli</h2></div>
          <Carousel label="Ultimi articoli">
            {articles.map((a, i) => <Card a={a} i={i % 4} />)}
          </Carousel>
        </section>

        <!-- tutti gli articoli (quando sono tanti) -->
        {showAll && (
          <section class="wrap jsec" aria-labelledby="all-title">
            <div class="jhead"><h2 class="jlabel" id="all-title">Tutti gli articoli</h2></div>
            <div class="jposts">
              {articles.map((a, i) => <Card a={a} variant="post" img i={i % 3} />)}
            </div>
          </section>
        )}

        <Newsletter source="journal-home" />
      </>
    )}
  </div>
</Base>

<script>
  import '../../scripts/journal.ts';
</script>
