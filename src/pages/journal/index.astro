---
import { p, isHome } from '../../lib/paths.js';
import Base from '../../layouts/Base.astro';
import { getArticles, fmtDate } from '../../lib/journal.js';
import { CTA } from '../../data/site.js';

const articles = await getArticles();
const empty = articles.length === 0;
const [featured, ...rest] = [...articles].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<Base
  title="Flowline Journal | Automazione e AI per le aziende"
  description="Flowline Journal: articoli editoriali su automazione, intelligenza artificiale e trasformazione digitale per le aziende."
  path="/journal"
  noindex={empty}
>
  <section class="section journal">
    <div class="wrap">
      <h1 class="display" data-rise>Flowline Journal</h1>
      <p class="lead journal__intro" data-rise style="--i:1">Idee, analisi e casi reali su automazione, intelligenza artificiale e processi aziendali. Contenuti curati per chi vuole far crescere la propria impresa.</p>

      {empty ? (
        <div class="journal__empty" data-rise style="--i:2">
          <span class="journal__line" aria-hidden="true"></span>
          <p class="lead">I primi articoli sono in preparazione.</p>
          <p>Nel frattempo, se vuoi capire cosa possiamo automatizzare nella tua azienda, parliamone direttamente.</p>
          <p><a class="button" href={p('/#contatti')}>{CTA} <Fragment set:html={arrow} /></a></p>
        </div>
      ) : (
        <>
          <article class="jfeat" data-reveal>
            {featured.cover_image && <img class="jfeat__img" src={featured.cover_image} alt={featured.cover_alt || ''} loading="eager" width="1200" height="630" onerror="this.remove()" />}
            <div class="jfeat__text">
              <p class="small muted">{featured.category?.name} · <time datetime={featured.published_at}>{fmtDate(featured.published_at)}</time></p>
              <h2 class="head"><a href={p(`/journal/${featured.slug}`)}>{featured.title}</a></h2>
              {featured.subtitle && <p class="lead">{featured.subtitle}</p>}
              <p class="small muted">{featured.reading_time || 1} min di lettura</p>
            </div>
          </article>
          <ul class="jlist" role="list">
            {rest.map((a, i) => (
              <li data-reveal style={`--i:${i % 3}`}>
                <p class="small muted">{a.category?.name} · <time datetime={a.published_at}>{fmtDate(a.published_at)}</time> · {a.reading_time || 1} min</p>
                <h2 class="name"><a href={p(`/journal/${a.slug}`)}>{a.title}</a></h2>
                {a.subtitle && <p>{a.subtitle}</p>}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .journal { padding-top: clamp(2rem, 6vw, 5rem); min-height: 70svh; }
  .journal__intro { max-width: 36ch; margin-top: 1.5rem; font-weight: 400; }
  .journal__empty { margin-top: clamp(3rem, 7vw, 6rem); display: flex; flex-direction: column; gap: 1.25rem; max-width: 44rem; }
  .journal__line { display: block; width: min(100%, 22rem); height: 10px; background: var(--orange); border-radius: 0 5px 5px 0; }
  .jfeat { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: 7fr 5fr; gap: var(--gutter); align-items: end; }
  .jfeat__img { width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; }
  .jfeat__text { display: flex; flex-direction: column; gap: 1rem; }
  .jfeat a, .jlist a { text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .jfeat h2 a:hover, .jlist h2 a:hover { text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 0.15em; text-decoration-thickness: 0.08em; } }
  .jlist { margin-top: clamp(3rem, 6vw, 5rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem var(--gutter); }
  .jlist li { display: flex; flex-direction: column; gap: 0.7rem; padding-top: 1.25rem; border-top: 6px solid var(--orange); }
  @media (max-width: 860px) { .jfeat { grid-template-columns: 1fr; } .jlist { grid-template-columns: 1fr; } }
</style>
