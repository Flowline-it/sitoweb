---
import Base from '../layouts/Base.astro';
import { p } from '../lib/paths.js';
import { CTA, PRODUCTS, SITE } from '../data/site.js';

const META = {
  title: 'Prodotti AI per le aziende | Flowline',
  description: "I prodotti di Flowline, pronti da attivare oltre ai progetti su misura. In arrivo l'Assistente WhatsApp: risponde ai clienti con le informazioni della tua azienda.",
};
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const url = `${SITE.url}/prodotti/`;
const jsonld = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: META.title, description: META.description, inLanguage: 'it-IT', isPartOf: { '@id': `${SITE.url}/#website` }, breadcrumb: { '@id': `${url}#breadcrumb` } },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Prodotti', item: url },
  ] },
];
---
<Base title={META.title} description={META.description} path="/prodotti" jsonld={jsonld}>
  <section class="page-hero" aria-labelledby="page-title">
    <span class="glow page-hero__glow" aria-hidden="true"></span>
    <div class="wrap page-hero__inner">
      <nav class="crumbs" aria-label="Percorso" data-rise style="--i:0">
        <a href={p('/')}>Home</a><span aria-hidden="true">/</span><span aria-current="page">Prodotti</span>
      </nav>
      <h1 id="page-title" class="display" data-rise style="--i:1">{PRODUCTS.title}</h1>
      <p class="lead" data-rise style="--i:2">{PRODUCTS.text}</p>
    </div>
  </section>

  <section class="section products" aria-label="Elenco prodotti">
    <div class="wrap">
      {PRODUCTS.items.map((pr) => (
        <article id={pr.id} class="card product" data-reveal>
          <div class="product__text">
            <span class="badge product__badge">{pr.status}</span>
            <h2 class="h2">{pr.name}</h2>
            <p class="lead">{pr.text}</p>
            <ul class="checks">{pr.points.map((pt) => <li>{pt}</li>)}</ul>
            <p class="muted">{pr.note}</p>
            <p><a class="button button--ink" href={`mailto:${SITE.email}?subject=${encodeURIComponent(pr.name + ': voglio provarlo')}`}>Avvisami quando è pronto <Fragment set:html={arrow} /></a></p>
          </div>
          <div class="product__ui" aria-hidden="true">
            <div class="chat">
              <p class="chat__head"><span class="chat__dot"></span>Assistente · WhatsApp</p>
              <p class="bubble bubble--me">Buongiorno, siete aperti sabato?</p>
              <p class="bubble bubble--bot">Buongiorno! Sì, sabato siamo aperti la mattina. Vuole che le fissi un appuntamento?</p>
              <p class="bubble bubble--me bubble--voice"><span class="wave"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span> Messaggio vocale</p>
              <p class="bubble bubble--bot">Certo, le propongo sabato alle 10. Le va bene?</p>
            </div>
          </div>
        </article>
      ))}
      <p class="products__more" data-reveal>Cerchi qualcosa di costruito sulla tua azienda? <a class="link" href={p('/#contatti')}>{CTA}</a> oppure scopri <a class="link" href={p('/metodo')}>come lavoriamo</a>.</p>
    </div>
  </section>
</Base>

<style>
  .page-hero { position: relative; padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem); overflow: hidden; }
  .page-hero__glow { width: min(64rem, 140vw); height: 34rem; left: 50%; top: -14rem; transform: translateX(-50%); }
  .page-hero__inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; }
  .page-hero .lead { max-width: 40rem; }
  .crumbs { display: flex; gap: 0.5rem; font-size: 0.875rem; color: var(--muted); }
  .crumbs a { color: inherit; text-decoration: none; display: inline-block; min-height: 24px; line-height: 24px; }
  .crumbs [aria-current] { color: var(--ink); font-weight: 500; line-height: 24px; }

  .product { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; padding: clamp(1.75rem, 4vw, 3rem); }
  .product__text { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .product__badge { background: var(--accent-soft); color: var(--accent-text); }
  .product .checks { margin: 0.25rem 0; }
  .product__ui { border-radius: 20px; background: var(--surface-2); padding: clamp(1rem, 3vw, 1.75rem); }
  .chat { display: grid; gap: 0.6rem; background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 1rem; box-shadow: var(--shadow); }
  .chat__head { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 600; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border); }
  .chat__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
  .bubble { max-width: 85%; padding: 0.55rem 0.8rem; border-radius: 14px; font-size: 0.875rem; line-height: 1.4; }
  .bubble--me { justify-self: end; background: var(--ink); color: #fff; border-bottom-right-radius: 4px; }
  .bubble--bot { justify-self: start; background: var(--surface-2); border-bottom-left-radius: 4px; }
  .bubble--voice { display: inline-flex; align-items: center; gap: 0.5rem; }
  .wave { display: inline-flex; align-items: center; gap: 2px; height: 14px; }
  .wave i { width: 3px; border-radius: 2px; background: currentColor; opacity: 0.8; height: 40%; }
  .wave i:nth-child(2n) { height: 90%; } .wave i:nth-child(3n) { height: 60%; }
  .products__more { margin-top: 2rem; text-align: center; color: var(--muted); }
  @media (max-width: 860px) { .product { grid-template-columns: 1fr; } }
</style>
