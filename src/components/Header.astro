---
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
---
<header class:list={['site-header', !onHome && 'is-solid']}>
  <div class="wrap">
    <div class="nav-shell">
      <a class="brand" href="/" aria-label="Flowline, home">
        <img src="/brand/flowline-logo-dark.png" alt="Flowline" width="1600" height="320" />
      </a>
      <nav class="nav" id="nav" aria-label="Principale">
        <a href={`${base}#soluzioni`}>Soluzioni</a>
        <a href={`${base}#metodo`}>Metodo</a>
        <a href={`${base}#formule`}>Formule</a>
        <a href={`${base}#chi-siamo`}>Chi siamo</a>
        <a href={`${base}#faq`}>FAQ</a>
      </nav>
      <div class="nav-actions">
        <a class="text-link" href="mailto:info@flowline.it">Scrivici</a>
        <a class="button button--ink button--sm" href={`${base}#contatti`}>Prenota una call</a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Apri il menu"><span></span></button>
      </div>
    </div>
  </div>
</header>
