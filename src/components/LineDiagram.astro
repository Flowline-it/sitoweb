---
// "Da sparso a ordinato": il lavoro manuale (quadratini sparsi) viene stretto in un nastro
// e ne esce come un'unica linea arancio che entra nel marchio. Generato alla build, sempre uguale.
interface Props { vertical?: boolean }
const { vertical = false } = Astro.props;

function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(7);
const S = 12;            // lato del quadratino
const rows = [129, 147, 165];
type Sq = { x: number; y: number; c: string; dx: number; dy: number; d: number };
const squares: Sq[] = [];
// zona sparsa
for (let i = 0; i < 64; i++) {
  const x = 16 + r() * 380;
  const y = 22 + r() * 250;
  squares.push({ x, y, c: r() > 0.45 ? '#bdbab2' : '#8a8880', dx: (r() - 0.5) * 30, dy: (r() - 0.5) * 30, d: r() * 400 });
}
// zona che si stringe nel nastro
const cols = 20;
for (let k = 0; k < cols; k++) {
  const t = k / (cols - 1);
  for (let j = 0; j < 3; j++) {
    if (r() < 0.25 * (1 - t)) continue;
    const gx = 420 + k * 18.5;
    const spread = 95 * Math.pow(1 - t, 1.6);
    const y = rows[j] + (r() - 0.5) * 2 * spread;
    const x = gx + (r() - 0.5) * 22 * (1 - t);
    const c = t > 0.6 ? '#1f1f1e' : t > 0.3 ? '#55544f' : '#8a8880';
    squares.push({ x, y, c, dx: 0, dy: (r() - 0.5) * 120 * (1 - t) + (y > 150 ? 20 : -20), d: 250 + k * 35 });
  }
}
const W = 1200, H = 300;
const map = (x: number, y: number) => (vertical ? { x: y, y: x * 0.5 } : { x, y });
const vb = vertical ? `0 0 ${H} ${W * 0.5 + 104}` : `0 0 ${W} ${H}`;
// linea + marchio
const barStart = 790, barEnd = 1062, cx = 1104, cy = 147 + S / 2;
const bar = vertical
  ? { x: rows[0], y: barStart * 0.5, w: rows[2] + S - rows[0], h: (barEnd - barStart) * 0.5 + 12 }
  : { x: barStart, y: rows[0], w: barEnd - barStart + 12, h: rows[2] + S - rows[0] };
const c = map(cx, cy);
const ringOuter = 86, ringInner = 66, disc = 56;
// apertura dell'anello dal lato da cui entra la linea, come nel logo
const gap = vertical ? `M ${c.x - 40} ${c.y - 120} h 80 v 70 h -80 z` : `M ${c.x - 120} ${c.y - 40} h 70 v 80 h -70 z`;
const maskId = vertical ? 'ld-mask-v' : 'ld-mask-h';
---
<svg class:list={['line-diagram', vertical ? 'is-vertical' : 'is-horizontal']} viewBox={vb} role="img" aria-label="Attività sparse che, passo dopo passo, diventano un'unica linea ordinata" data-reveal>
  <defs>
    <mask id={maskId}>
      <rect x="-10" y="-10" width="2000" height="2000" fill="#fff" />
      <path d={gap} fill="#000" />
    </mask>
  </defs>
  <g class="ld-squares">
    {squares.map((s) => {
      const p = map(s.x, s.y);
      const dx = vertical ? s.dy : s.dx;
      const dy = vertical ? s.dx : s.dy;
      return <rect x={p.x.toFixed(1)} y={p.y.toFixed(1)} width={S} height={S} fill={s.c} style={`--dx:${dx.toFixed(0)}px;--dy:${dy.toFixed(0)}px;--d:${s.d.toFixed(0)}ms`} />;
    })}
  </g>
  <rect class="ld-bar" x={bar.x} y={bar.y} width={bar.w} height={bar.h} fill="#ff9900" />
  <g class="ld-mark">
    <circle cx={c.x} cy={c.y} r={(ringOuter + ringInner) / 2} fill="none" stroke="#292929" stroke-width={ringOuter - ringInner} mask={`url(#${maskId})`} />
    <circle cx={c.x} cy={c.y} r={disc} fill="#ff9900" />
  </g>
</svg>

<style>
  .line-diagram { width: 100%; height: auto; overflow: visible; }
  .line-diagram rect, .line-diagram .ld-mark { transform-box: fill-box; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .line-diagram[data-reveal] { opacity: 1; transform: none; }
    :global(.js) .line-diagram .ld-squares rect { transform: translate(var(--dx), var(--dy)); opacity: 0.15; transition: transform 1200ms var(--ease-out) var(--d), opacity 900ms ease var(--d); }
    :global(.js) .line-diagram.is-horizontal .ld-bar { transform: scaleX(0); transform-origin: left center; }
    :global(.js) .line-diagram.is-vertical .ld-bar { transform: scaleY(0); transform-origin: center top; }
    :global(.js) .line-diagram .ld-bar { transition: transform 900ms var(--ease-in-out) 1100ms; }
    :global(.js) .line-diagram .ld-mark { transform: scale(0.7); opacity: 0; transform-origin: center; transition: transform 700ms var(--ease-out) 1800ms, opacity 400ms ease 1800ms; }
    :global(.js) .line-diagram.is-in .ld-squares rect { transform: none; opacity: 1; }
    :global(.js) .line-diagram.is-in .ld-bar { transform: none; }
    :global(.js) .line-diagram.is-in .ld-mark { transform: none; opacity: 1; }
  }
</style>
