---
import { SITE } from '../data/site.js';
const onHome = Astro.url.pathname === '/';
const base = onHome ? '' : '/';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/flowline-logo-dark.png" alt="Flowline" width="1600" height="320" loading="lazy" />
        <p>Automazioni e agenti AI su misura per le aziende. Niente teoria, solo automazioni che funzionano.</p>
      </div>
      <nav class="footer-col" aria-labelledby="f-sol">
        <h2 id="f-sol">Soluzioni</h2>
        <ul>
          <li><a href={`${base}#soluzioni`}>Automazioni processi</a></li>
          <li><a href={`${base}#soluzioni`}>Agenti AI personalizzati</a></li>
          <li><a href={`${base}#soluzioni`}>Consulenza strategica</a></li>
          <li><a href={`${base}#soluzioni`}>Formazione team</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="f-az">
        <h2 id="f-az">Azienda</h2>
        <ul>
          <li><a href={`${base}#chi-siamo`}>Chi siamo</a></li>
          <li><a href={`${base}#metodo`}>Metodo</a></li>
          <li><a href={`${base}#formule`}>Formule</a></li>
          <li><a href={`${base}#faq`}>FAQ</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="f-ris">
        <h2 id="f-ris">Risorse</h2>
        <ul>
          <li><a href="/journal">Journal</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-labelledby="f-con">
        <h2 id="f-con">Contatti</h2>
        <ul>
          <li><a href={`${base}#contatti`}>Prenota una consulenza</a></li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href={SITE.instagram} rel="noopener">Instagram</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-legal">
      <p>© {year} Flowline · {SITE.legalName} · {SITE.street}, {SITE.postalCode} {SITE.city} ({SITE.province}) · P.IVA {SITE.vat}</p>
      <p><a href="/privacy-policy" class="link" style="color:inherit;font-weight:500">Privacy Policy</a></p>
    </div>
  </div>
</footer>
